# ローカル開発用の設定例。cp .env.example .env でコピーして使う。
# APIキーは使わない。gcloud auth application-default login でログインしておく。

# Gemini は Vertex AI 経由で、ADC（自分のアカウント）で呼ぶ
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
# モデルが提供されているリージョン。新しいモデルは global でしか使えないことがある
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash

# 手元では IAP がないので local にする。本番（Cloud Run）では必ず iap にする
AUTH_MODE=local
LOCAL_USER=local-user@example.com

# ローカルは SQLite
DATABASE_URL=sqlite+aiosqlite:///./local.db
